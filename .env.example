# Pin releases. Docker selects ARM64 on Apple Silicon and AMD64 on x86 Linux.
ASTRBOT_IMAGE=soulter/astrbot:v4.29.0-beta.2
NAPCAT_IMAGE=mlikiowa/napcat-docker:v4.18.37
ASTRBOT_PORT=6185
NAPCAT_PORT=6099
# Linux: set these to the output of id -u and id -g before first startup.
# Docker Desktop uses a Linux VM; these defaults work with its file sharing.
NAPCAT_UID=1000
NAPCAT_GID=1000
# Enter model credentials in AstrBot WebUI; they are stored in runtime/.
