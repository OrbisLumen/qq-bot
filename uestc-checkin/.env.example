TZ=Asia/Shanghai
UESTC_USERNAME=
UESTC_PASSWORD=
AUTH_SUCCESS_SELECTOR=button:has-text("未读通知")
TASK_TIMEOUT_SECONDS=120
PAGE_TIMEOUT_SECONDS=25
AUTH_WAIT_SECONDS=30

# Playwright built-in WGS84 geolocation. Both empty means no override.
GEO_LATITUDE=
GEO_LONGITUDE=
GEO_ACCURACY_METERS=30

# Real page selectors are intentionally unset until verified.
# Use a direct business URL OR an entry selector on the authenticated hall page.
CHECKIN_URL=
CHECKIN_ENTRY_SELECTOR=
# Optional iframe selector within the checkin page.
CHECKIN_FRAME_SELECTOR=
CHECKIN_PENDING_SELECTOR=
CHECKIN_COMPLETED_SELECTOR=
# Must point to the timestamp of TODAY'S verified record.
CHECKIN_TIME_SELECTOR=
CHECKIN_NOT_STARTED_SELECTOR=
CHECKIN_SUBMIT_SELECTOR=
# Optional DOM confirmation button, not a JS alert/confirm dialog.
CHECKIN_CONFIRM_SELECTOR=
CHECKIN_ADAPTER=generic
CHECKIN_ENABLED=false
CHECKIN_HOUR=21
CHECKIN_MINUTE=5

# OneBot HTTP API, NOT NapCat WebUI (6099). Leave both empty to disable notifications.
# Host Docker service on Mac: http://host.docker.internal:<actual-api-port>
# Cloud: http://qq-bot-napcat-1:3000 with BOT_NETWORK=qq-bot_bot and scripts/cloud.sh.
NAPCAT_HTTP_URL=
NAPCAT_TOKEN=
QQ_USER_ID=
BOT_NETWORK=
